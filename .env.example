# Optional API URL override. Expo development builds discover the computer's
# Expo host automatically. For production, uncomment and set your deployed
# API base URL (including /api/v1).
# EXPO_PUBLIC_API_URL=https://your-api-host.example/api/v1
# Android emulator: use http://10.0.2.2:8000/api/v1
# iOS simulator: use http://127.0.0.1:8000/api/v1
# Physical phone: use your computer's LAN IP, for example http://192.168.1.25:8000/api/v1
# EXPO_PUBLIC_API_URL=http://192.168.1.25:8000/api/v1

# Optional Google Maps SDK keys for custom/release builds. Restrict each key
# to this app's Android package or iOS bundle identifier and Maps SDK only.
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=
# Browser key: restrict by HTTP referrer and enable the Maps JavaScript API.
# EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=